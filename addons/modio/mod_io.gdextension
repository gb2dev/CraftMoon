[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6

[libraries]
windows.debug.x86_64 = "win/mod_io.debug.x64.dll"
windows.release.x86_64 = "win/mod_io.x64.dll"
linux.debug.x86_64 = "linux/libmod_io.debug.x64.so"
linux.release.x86_64 = "linux/libmod_io.x64.so"

[Icon]
ModIO = "res://addons/mod_io/icons/modio.svg"
